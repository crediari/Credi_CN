{
  "include": ["**/*.ts", "**/*.tsx"],
  "compilerOptions": {
    "target": "ES2023",
    "jsx": "react-jsx",
    "module": "ESNext",
    "paths": {
      "@/components/ui/avatar": ["./registry/items/components/avatar/avatar.tsx"],
      "@/components/ui/calendar": ["./registry/items/components/calendar/calendar.tsx"],
      "@/components/ui/popover": ["./registry/items/components/popover/popover.tsx"],
      "@/*": ["./src/*"],
      "content-collections": ["./.content-collections/generated"]
    },
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "types": ["vite/client"],

    /* Bundler mode */
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true,
    "verbatimModuleSyntax": false,
    "noEmit": true,

    /* Linting */
    "skipLibCheck": true,
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "noUncheckedSideEffectImports": true
  }
}
